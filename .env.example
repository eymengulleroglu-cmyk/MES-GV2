# Frontend (Vite) — build sırasında gömülür
VITE_API_URL=https://your-api-service.onrender.com

# Backend (server/) — Render env vars olarak tanımlanır, depoya konmaz
DATABASE_URL=postgresql://user:pass@host:5432/mesg
JWT_SECRET=change-me-in-production
SETUP_TOKEN=tek-kullanimlik-kurulum-anahtari
CORS_ORIGIN=https://your-frontend-url
NODE_ENV=production
PORT=4000
